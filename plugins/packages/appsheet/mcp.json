{
  "mcpServers": {
    "appsheet": {
      "type": "stdio",
      "command": "node",
      "args": ["../../../scripts/mcp-gateway-router.js", "appsheet"],
      "env": {
        "CORTEX_GATEWAY_URL": "http://localhost:8080",
        "CORTEX_PROBE_TIMEOUT_MS": "300"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": ["../../../scripts/mcp-gateway-router.js", "playwright"],
      "env": {
        "CORTEX_GATEWAY_URL": "http://localhost:8080",
        "CORTEX_PROBE_TIMEOUT_MS": "300"
      }
    }
  }
}
