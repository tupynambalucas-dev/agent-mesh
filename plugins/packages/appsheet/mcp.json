{
  "mcpServers": {
    "appsheet": {
      "type": "stdio",
      "command": "node",
      "args": ["./scripts/launcher.cjs", "appsheet"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--user-data-dir",
        "${PLUGIN_DATA}/appsheet-profile",
        "--headless"
      ]
    }
  }
}
