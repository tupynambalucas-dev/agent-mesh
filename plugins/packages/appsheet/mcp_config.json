{
  "mcpServers": {
    "appsheet": {
      "command": "node",
      "args": ["./scripts/launcher.cjs", "appsheet"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--user-data-dir",
        "${PLUGIN_DATA}/appsheet-profile",
        "--headless"
      ],
      "enabledTools": [
        "browser_navigate",
        "browser_snapshot",
        "browser_click",
        "browser_type",
        "browser_wait_for",
        "browser_take_screenshot"
      ]
    }
  }
}
