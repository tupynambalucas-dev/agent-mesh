{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--user-data-dir",
        "${PLUGIN_DATA}/browser-profile",
        "--headless"
      ]
    },
    "playwright-desktop": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--extension"
      ],
      "disabled": true
    },
    "firecrawl": {
      "command": "node",
      "args": ["../../../scripts/mcp-gateway-router.js", "firecrawl"],
      "env": {
        "CORTEX_GATEWAY_URL": "http://localhost:8080",
        "CORTEX_PROBE_TIMEOUT_MS": "300"
      }
    }
  }
}
