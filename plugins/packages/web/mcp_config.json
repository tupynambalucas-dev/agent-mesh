{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--user-data-dir",
        "${PLUGIN_DATA}/browser-profile",
        "--headless"
      ]
    },
    "playwright-desktop": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--extension"
      ],
      "disabled": true
    },
    "firecrawl": {
      "command": "node",
      "args": ["./scripts/launcher.cjs", "firecrawl"]
    }
  }
}
