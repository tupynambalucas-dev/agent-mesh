      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-atelier"
    },
    "plugins/packages/docusaurus": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-docusaurus"
    },
    "plugins/packages/github-actions": {
