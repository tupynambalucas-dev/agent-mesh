{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "group-pull-request-title-pattern": "chore(release): release main",
  "pull-request-title-pattern": "chore(release): release ${component} ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features & Capabilities", "hidden": false },
    { "type": "fix", "section": "Bug Fixes & Corrections", "hidden": false },
    { "type": "perf", "section": "Performance Optimizations", "hidden": false },
    { "type": "refactor", "section": "Refactoring & Internal Architecture", "hidden": false },
    { "type": "docs", "section": "Documentation & Specifications", "hidden": false },
    { "type": "security", "section": "Security & Vulnerability Patches", "hidden": false },
    { "type": "revert", "section": "Reverts & Rollbacks", "hidden": false },
    { "type": "chore", "scope": "deps", "section": "Dependencies", "hidden": false },
    { "type": "chore", "scope": "deps-dev", "section": "Dependencies", "hidden": false },
    { "type": "chore", "scope": "release", "section": "Releases", "hidden": true },
    { "type": "chore", "section": "Maintenance", "hidden": false },
    { "type": "build", "section": "Maintenance", "hidden": false },
    { "type": "ci", "section": "Maintenance", "hidden": false },
    { "type": "test", "section": "Maintenance", "hidden": false },
    { "type": "style", "section": "Styling & Linting", "hidden": true }
  ],
  "include-commit-authors": true,
  "component-no-space": true,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/agent-mesh",
      "changelog-path": "CHANGELOG.md"
    },
    "plugins/packages/appsheet": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-appsheet"
    },
    "plugins/packages/atelier": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-atelier"
    },
    "plugins/packages/docusaurus": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-docusaurus"
    },
    "plugins/packages/github-actions": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-actions"
    },
    "plugins/packages/github-flow": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-flow"
    },
    "plugins/packages/github-org": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-org"
    },
    "plugins/packages/github-releases": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-releases"
    },
    "plugins/packages/github-repo": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-repo"
    },
    "plugins/packages/gwork": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-gwork"
    },
    "plugins/packages/profile": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-profile"
    },
    "plugins/packages/research": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-research"
    },
    "plugins/packages/secrets": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-secrets"
    },
    "plugins/packages/web": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-web"
    },
    "mcp/core/github": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-core-github"
    },
    "mcp/servers/appsheet": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-appsheet"
    },
    "mcp/servers/firecrawl": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-firecrawl"
    },
    "mcp/servers/github-delivery": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-github-delivery"
    },
    "mcp/servers/github-governance": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-github-governance"
    },
    "mcp/servers/gwork": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-gwork"
    },
    "mcp/servers/infisical": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-infisical"
    },
    "mcp/servers/linkedin": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-linkedin"
    },
    "mcp/servers/memory": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-memory"
    },
    "mcp/servers/playwright": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/mcp-playwright"
    }
  },
  "plugins": [
    "node-workspace"
  ]
}
