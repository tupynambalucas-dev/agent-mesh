      "package-name": "@tupynambalucas-dev/plugin-github-actions"
    },
    "plugins/packages/github-flow": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-flow"
    },
    "plugins/packages/github-org": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-org"
    },
    "plugins/packages/github-releases": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-releases"
    },
    "plugins/packages/github-repo": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-github-repo"
    },
    "plugins/packages/gwork": {
      "release-type": "node",
      "package-name": "@tupynambalucas-dev/plugin-gwork"
    },
    "plugins/packages/profile": {
      "release-type": "node",
