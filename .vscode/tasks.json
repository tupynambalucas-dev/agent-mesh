{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Antigravity CLI (agent-mesh)",
      "type": "process",
      "command": "wt.exe",
      "windows": {
        "command": "wt.exe",
        "args": [
          "-d",
          "${workspaceFolder}",
          "powershell.exe",
          "-NoExit",
          "-Command",
          "agy"
        ]
      },
      "osx": {
        "command": "osascript",
        "args": [
          "-e",
          "tell application \"Terminal\" to do script \"cd '${workspaceFolder}' && agy\""
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "-c",
          "nohup x-terminal-emulator -e bash -c 'cd \"${workspaceFolder}\" && agy; exec bash' >/dev/null 2>&1 &"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "Validate Plugin (Strict)",
      "type": "shell",
      "command": "agy plugin validate . --strict",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
