# ==============================================================================
# agent-mesh - Sovereign Agent Governance & MCP Fallback Environment Template
# ==============================================================================
# Corporate Single Source of Truth (SSOT): Infisical Cloud (tupynambalucas-dev)
# Project: tupynambalucas-dev-agent-mesh
#
# INSTRUCTIONS:
# 1. Copy this file to .env in your active workspace (e.g. agent-mesh/.env or org-core/.env).
# 2. Never commit .env to version control. The .gitignore enforces this invariant.
# 3. For Bring-Your-Own-Token (BYOT) developer workstations, fill in your personal keys below.
# ==============================================================================

# ==============================================================================
# 1. Infisical Cloud - Universal Auth (Machine Identity for Autonomous Secrets)
# ==============================================================================
# Used by: @infisical/mcp and the secrets-expert skill to inspect, manage, and
# inject secrets dynamically into processes without requiring interactive login.
#
# HOW TO CONFIGURE FINE-GRAINED PERMISSIONS IN INFISICAL:
# 1. Log in to Infisical Cloud (https://app.infisical.com) under org 'tupynambalucas-dev'.
# 2. Navigate to: Organization Settings -> Access Control -> Machine Identities.
# 3. Click "Add Machine Identity":
#    - Name: "agent-mesh-runner" (or developer name)
#    - Auth Method: Universal Auth
# 4. Generate Client Secret:
#    - Save the generated Client ID and Client Secret below.
# 5. Assign Project-Level RBAC Role (MANDATORY PRINCIPLE OF LEAST PRIVILEGE):
#    - Go to Project 'tupynambalucas-dev-agent-mesh' -> Project Settings -> Access Control.
#    - Add the Machine Identity with Role: "Viewer" (Read-Only) or "Developer".
#    - NEVER grant Organization Admin or full Project Admin to agent runners.
# ==============================================================================
INFISICAL_HOST_URL=https://app.infisical.com
INFISICAL_AUTH_METHOD=universal-auth
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=134783dd-8a83-4dfc-9fd5-979b52bed86d
INFISICAL_ENVIRONMENT=dev

# ==============================================================================
# 2. GitHub MCP Server - Repository Inspection & PR Governance
# ==============================================================================
# Used by: github-mcp-server-js and github-org-manager skill to inspect code,
# tree structures, pull requests, issues, and organization governance.
#
# HOW TO CONFIGURE FINE-GRAINED PERMISSIONS IN GITHUB:
# Option A: Fine-Grained Personal Access Token (Recommended)
# 1. Navigate to: GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens.
# 2. Click "Generate new token":
#    - Token name: "agent-mesh-dev"
#    - Resource owner: "tupynambalucas-dev"
#    - Repository access: "All repositories" (or selected: platform, docs, agent-mesh, org-core, .github)
# 3. Required Permissions:
#    - Repository Permissions:
#      - Contents: Read-only (inspect files, trees, code)
#      - Metadata: Read-only (mandatory by GitHub API)
#      - Pull requests: Read-only (or Read and Write if reviewing/creating PRs)
#      - Issues: Read-only (inspect bug reports and tasks)
#    - Organization Permissions:
#      - Members: Read-only (inspect team structure and collaborators)
#
# Option B: Classic Personal Access Token (Legacy fallback)
# 1. Navigate to: Personal access tokens -> Tokens (classic).
# 2. Scopes required:
#    - 'repo' (Full control of private repositories)
#    - 'read:org' (Read org and team membership)
# ==============================================================================
GITHUB_TOKEN=

# ==============================================================================
# 3. Firecrawl MCP Server - Web Scraping & Deep Web Search
# ==============================================================================
# Used by: firecrawl-mcp to search documentation portals, scrape deep web
# pages, and convert complex HTML into clean Markdown for agent context.
#
# HOW TO OBTAIN:
# 1. Register or log in at: https://www.firecrawl.dev
# 2. Navigate to: Dashboard -> API Keys.
# 3. Create a developer key (e.g., 'agent-mesh-local-dev').
# 4. Note: Developer fallback uses separate developer pool quotas; never use
#    the cluster production key (PLATFORM_FIRECRAWL_KEY).
# ==============================================================================
FIRECRAWL_API_KEY=

# ==============================================================================
# 4. Context7 MCP Server - Up-to-Date Library & Framework Documentation
# ==============================================================================
# Used by: @upstash/context7-mcp to retrieve live, current documentation for
# npm/pip/go packages and libraries without outdated LLM training weight drift.
#
# HOW TO OBTAIN:
# 1. Navigate to: https://context7.ai (Upstash Context7)
# 2. Authenticate and copy your API key from the dashboard.
# ==============================================================================
CONTEXT7_API_KEY=

# ==============================================================================
# 5. Tupynambá Enterprise Gateway (Remote Cortex Gateway Ingress)
# ==============================================================================
# Used by: mcp-gateway-router.js when connecting over Streamable HTTP to the
# central in-cluster agentgateway (https://mcp.tupynambalucas.dev/mcp).
# Leave blank or use dummy value if running 100% in local stdio fallback mode.
# ==============================================================================
TUPYNAMBA_GATEWAY_TOKEN=
