{
  "mcpServers": {
    "enterprise-gateway": {
      "serverUrl": "https://mcp.tupynambalucas.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${TUPYNAMBA_GATEWAY_TOKEN}"
      },
      "variables": [
        {
          "name": "TUPYNAMBA_GATEWAY_TOKEN"
        }
      ]
    },
    "infisical-mcp": {
      "command": "pnpm",
      "args": ["dlx", "@infisical/mcp"],
      "env": {
        "INFISICAL_HOST_URL": "${INFISICAL_HOST_URL}",
        "INFISICAL_AUTH_METHOD": "${INFISICAL_AUTH_METHOD}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET}",
        "INFISICAL_PROJECT_ID": "${INFISICAL_PROJECT_ID}",
        "INFISICAL_ENVIRONMENT": "${INFISICAL_ENVIRONMENT}",
        "INFISICAL_MASK_SECRET_VALUES": "false"
      },
      "variables": [
        {
          "name": "INFISICAL_HOST_URL"
        },
        {
          "name": "INFISICAL_AUTH_METHOD"
        },
        {
          "name": "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID"
        },
        {
          "name": "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET"
        },
        {
          "name": "INFISICAL_PROJECT_ID"
        },
        {
          "name": "INFISICAL_ENVIRONMENT"
        }
      ]
    },
    "github-mcp": {
      "command": "pnpm",
      "args": ["dlx", "github-mcp-server-js"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "variables": [
        {
          "name": "GITHUB_TOKEN"
        }
      ]
    },
    "firecrawl-mcp": {
      "command": "pnpm",
      "args": ["dlx", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "variables": [
        {
          "name": "FIRECRAWL_API_KEY"
        }
      ]
    },
    "context7-mcp": {
      "command": "pnpm",
      "args": ["dlx", "@upstash/context7-mcp", "--api-key", "${CONTEXT7_API_KEY}"],
      "variables": [
        {
          "name": "CONTEXT7_API_KEY"
        }
      ]
    }
  }
}
