{
  "name": "@tupynambalucas-dev/agent-mcp-github",
  "version": "1.0.0",
  "description": "Enterprise Model Context Protocol server for GitHub operations using GitHub App authentication and fine-grained permissions.",
  "author": "Tupynamba Lucas Development Team <contato@tupynambalucas.dev>",
  "license": "MIT",
  "homepage": "https://docs.tupynambalucas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas-dev/agent-mesh.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-mcp-github": "./dist/bin.js"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:mcp-stack",
    "@octokit/auth-app": "catalog:mcp-stack",
    "@octokit/core": "catalog:mcp-stack",
    "dotenv": "catalog:shared",
    "fastify": "catalog:mcp-stack",
    "zod": "catalog:shared"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist"
  ]
}
