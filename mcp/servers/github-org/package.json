{
  "name": "@tupynambalucas-dev/mcp-github-org",
  "version": "1.0.0",
  "description": "Domain-scoped Model Context Protocol server for GitHub organization governance, teams, rulesets, and security auditing via Tier 1 GitHub App authentication.",
  "author": "Tupynamba Lucas Development Team <contato@tupynambalucas.dev>",
  "license": "Apache-2.0",
  "homepage": "https://docs.tupynambalucas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas-dev/agent-mesh.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "mcp-github-org": "./scripts/launcher.cjs"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:mcp-stack",
    "@tupynambalucas-dev/mcp-core-github": "workspace:*",
    "fastify": "catalog:mcp-stack",
    "zod": "catalog:shared"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist",
    "scripts",
    "mcp.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ]
}
