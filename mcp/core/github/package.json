{
  "name": "@tupynambalucas-dev/mcp-core-github",
  "version": "1.0.0",
  "description": "Shared core library for GitHub MCP servers providing Three-Tier GitHub App authentication, Octokit client factories, and Zod schemas.",
  "author": "Tupynamba Lucas Development Team <contato@tupynambalucas.dev>",
  "license": "Apache-2.0",
  "homepage": "https://docs.tupynambalucas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas-dev/agent-mesh.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/auth-app": "catalog:mcp-stack",
    "@octokit/core": "catalog:mcp-stack",
    "dotenv": "catalog:shared",
    "zod": "catalog:shared"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ]
}
